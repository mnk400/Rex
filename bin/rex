#!/bin/bash
# rex — A dynamic CLI tool that auto-discovers scripts from configured directories
#
# Scripts are organized into topics (subdirectories) and standalone commands.
# Rex reads metadata from script headers for descriptions and ignore rules.
#
# Script metadata comments:
#   # Description: <text>              - Script description
#   # @raycast.description <text>      - Also accepted for description
#   # rex.ignore                       - Exclude script from discovery
#   # Runbook.ignore                   - Also accepted (backwards compat)

set -euo pipefail

REX_VERSION="0.dev.build"

# BSD find (macOS) uses -perm +111, GNU find (Linux) uses -perm $_PERM_EXEC
if [[ "$(uname)" == "Darwin" ]]; then
    _PERM_EXEC="+111"
else
    _PERM_EXEC="/111"
fi
REX_CONFIG_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/rex"
REX_CONFIG_FILE="$REX_CONFIG_DIR/config"
REX_MAX_DEPTH_CACHE=""

# ── Config ────────────────────────────────────────────────────────────────────

ensure_config() {
    if [[ ! -d "$REX_CONFIG_DIR" ]]; then
        mkdir -p "$REX_CONFIG_DIR"
    fi
    if [[ ! -f "$REX_CONFIG_FILE" ]]; then
        cat > "$REX_CONFIG_FILE" << 'EOF'
# Rex script directories (one path per line)
# Add directories with: rex dirs add <path>
EOF
    fi
}

# Read configured directories, skip comments, blank lines, and settings
get_directories() {
    ensure_config
    while IFS= read -r line; do
        line="${line%%#*}"           # strip inline comments
        line="${line#"${line%%[![:space:]]*}"}"  # trim leading whitespace
        line="${line%"${line##*[![:space:]]}"}"  # trim trailing whitespace
        [[ -n "$line" ]] || continue
        # Skip key=value settings lines
        [[ "$line" == *"="* ]] && continue
        [[ -d "$line" ]] && echo "$line"
    done < "$REX_CONFIG_FILE"
    return 0
}

# Read max topic nesting depth from config (default: 1, single level)
get_max_depth() {
    if [[ -n "$REX_MAX_DEPTH_CACHE" ]]; then
        echo "$REX_MAX_DEPTH_CACHE"
        return 0
    fi

    if [[ -f "$REX_CONFIG_FILE" ]]; then
        while IFS= read -r line; do
            line="${line%%#*}"                       # strip inline comments
            line="${line#"${line%%[![:space:]]*}"}"  # trim leading whitespace
            line="${line%"${line##*[![:space:]]}"}"  # trim trailing whitespace
            [[ -n "$line" ]] || continue

            if [[ "$line" =~ ^max_depth[[:space:]]*=[[:space:]]*(.*)$ ]]; then
                local val="${BASH_REMATCH[1]}"
                if [[ ! "$val" =~ ^[0-9]+$ ]] || [[ "$val" -lt 1 ]]; then
                    echo "Error: invalid max_depth '$val' in $REX_CONFIG_FILE (must be an integer >= 1)" >&2
                    return 1
                fi
                REX_MAX_DEPTH_CACHE="$val"
                echo "$REX_MAX_DEPTH_CACHE"
                return 0
            fi
        done < "$REX_CONFIG_FILE"
    fi
    REX_MAX_DEPTH_CACHE="1"
    echo "$REX_MAX_DEPTH_CACHE"
}

# Check if a topic path resolves to a usable topic directory in any configured
# scripts dir. Matches discover_topics' rule: directory must contain executables
# or subdirectories. One stat + at most two finds per configured dir — cheaper
# than enumerating siblings.
has_topic_dir() {
    local topic_path="$1"
    while IFS= read -r dir; do
        local candidate="$dir/$topic_path"
        [[ -d "$candidate" ]] || continue
        if find "$candidate" -maxdepth 1 -type f -perm $_PERM_EXEC 2>/dev/null | grep -q . || \
           find "$candidate" -mindepth 1 -maxdepth 1 -type d ! -name ".*" 2>/dev/null | grep -q .; then
            return 0
        fi
    done < <(get_directories)
    return 1
}

get_depth_from_path() {
    local topic_path="$1"
    local depth
    depth=$(echo "$topic_path" | tr -cd '/' | wc -c | tr -d ' ')
    echo $((depth + 1))
}

can_descend_from_topic() {
    local topic_path="$1"
    local depth max_depth
    depth=$(get_depth_from_path "$topic_path")
    max_depth=$(get_max_depth)
    [[ "$depth" -lt "$max_depth" ]]
}

# ── Metadata ──────────────────────────────────────────────────────────────────

get_script_description() {
    local script="$1"
    local description=""
    if [[ -f "$script" ]]; then
        description=$(grep -m1 "^#.*@raycast\.description\|^#.*Description:" "$script" 2>/dev/null \
            | sed 's/^#[[:space:]]*@raycast\.description[[:space:]]*//' \
            | sed 's/^#[[:space:]]*Description:[[:space:]]*//')
    fi
    echo "${description:-No description available}"
}

is_script_ignored() {
    local script="$1"
    [[ -f "$script" ]] && grep -qm1 "^#.*rex\.ignore\|^#.*Runbook\.ignore" "$script" 2>/dev/null
}

# ── Discovery ─────────────────────────────────────────────────────────────────

# Discover topics (or subtopics under a parent path) across all configured directories
# Usage: discover_topics [parent_path]
# Output: topic_name|directory_path
discover_topics() {
    local parent="${1:-}"
    while IFS= read -r dir; do
        local search_dir="$dir"
        [[ -n "$parent" ]] && search_dir="$dir/$parent"
        [[ -d "$search_dir" ]] || continue

        find "$search_dir" -maxdepth 1 -type d ! -name ".*" ! -path "$search_dir" 2>/dev/null | sort | while read -r topic_dir; do
            local topic
            topic=$(basename "$topic_dir")
            # Valid if it has executables OR has child subdirectories
            if find "$topic_dir" -maxdepth 1 -type f -perm $_PERM_EXEC 2>/dev/null | grep -q . || \
               find "$topic_dir" -maxdepth 1 -type d ! -path "$topic_dir" ! -name ".*" 2>/dev/null | grep -q .; then
                echo "$topic|$dir"
            fi
        done
    done < <(get_directories)
}

# Get unique topic names (or subtopic names under a parent path)
discover_topic_names() {
    discover_topics "${1:-}" | cut -d'|' -f1 | sort -u
}

# Discover commands for a topic path across all directories
# Usage: discover_commands <topic_path>  (e.g., "nas" or "nas/backup")
# Output: command_name|script_path|source_dir
discover_commands() {
    local topic_path="$1"
    local leaf
    leaf=$(basename "$topic_path")
    while IFS= read -r dir; do
        local topic_dir="$dir/$topic_path"
        [[ -d "$topic_dir" ]] || continue

        find "$topic_dir" -maxdepth 1 -type f -perm $_PERM_EXEC 2>/dev/null | sort | while read -r script; do
            is_script_ignored "$script" && continue
            local bn
            bn=$(basename "$script")
            local command_name="${bn%.*}"
            # Strip leaf prefix (e.g., backup-create -> create)
            command_name="${command_name#"$leaf"-}"
            echo "$command_name|$script|$dir"
        done
    done < <(get_directories)
}

# Discover standalone scripts across all directories
# Output: command_name|script_path|source_dir
discover_standalone() {
    while IFS= read -r dir; do
        find "$dir" -maxdepth 1 -type f -perm $_PERM_EXEC ! -name "rex*" ! -name "runbook*" 2>/dev/null | sort | while read -r script; do
            is_script_ignored "$script" && continue
            local bn
            bn=$(basename "$script")
            local command_name="${bn%.*}"
            echo "$command_name|$script|$dir"
        done
    done < <(get_directories)
}

# Resolve the first matching command from pipe-delimited discovery output
# Output: script_path
_resolve_first_match() {
    local command="$1"
    while IFS='|' read -r cmd script_path source_dir; do
        if [[ "$cmd" == "$command" ]]; then
            echo "$script_path"
            return 0
        fi
    done
}

resolve_command() {
    _resolve_first_match "$2" < <(discover_commands "$1")
}

resolve_standalone() {
    _resolve_first_match "$1" < <(discover_standalone)
}

# ── Helpers ───────────────────────────────────────────────────────────────────

# String-based dedup (bash 3.x compatible). Usage:
#   local _seen="|"
#   _is_seen "$name" && continue; _seen="$_seen$name|"
_is_seen() {
    case "$_seen" in
        *"|$1|"*) return 0 ;;
        *) return 1 ;;
    esac
}

# ── Display ───────────────────────────────────────────────────────────────────

show_help() {
    echo "rex v${REX_VERSION} — script runner"
    echo ""
    echo "Usage: rex <topic> <command> [args...]"
    echo "       rex <command> [args...]"
    echo ""

    local dirs
    dirs=$(get_directories)
    if [[ -z "$dirs" ]]; then
        echo "No directories configured. Add one with:"
        echo "  rex dirs add <path>"
        return
    fi

    local topics
    topics=$(discover_topic_names)
    if [[ -n "$topics" ]]; then
        echo "Topics:"
        while read -r topic; do
            local cmd_count
            cmd_count=$(discover_commands "$topic" | wc -l | tr -d ' ')
            printf "  %-16s %s commands\n" "$topic" "$cmd_count"
        done <<< "$topics"
        echo ""
    fi

    local standalone_count
    standalone_count=$(discover_standalone | wc -l | tr -d ' ')
    if [[ "$standalone_count" -gt 0 ]]; then
        echo "Standalone commands: $standalone_count available"
        echo ""
    fi

    echo "Commands:"
    echo "  rex <topic> list       Show commands for a topic"
    echo "  rex list               List all available commands"
    echo "  rex new <cmd>          Scaffold a new script"
    echo "  rex edit <cmd>         Open a script in \$EDITOR"
    echo "  rex dirs               Show configured directories"
    echo "  rex dirs add <path>    Add a script directory"
    echo "  rex dirs remove <path> Remove a script directory"
    echo "  rex version            Show version"
}

show_topic_help() {
    local topic_path="$1"
    local display_path="${topic_path//\// }"
    echo "Usage: rex $display_path <command> [args...]"
    echo ""

    # Show subtopics if depth allows
    local subtopics=""
    if can_descend_from_topic "$topic_path"; then
        subtopics=$(discover_topic_names "$topic_path")
    fi
    if [[ -n "$subtopics" ]]; then
        echo "Subtopics:"
        while read -r sub; do
            local sub_cmd_count
            sub_cmd_count=$(discover_commands "$topic_path/$sub" | wc -l | tr -d ' ')
            printf "  %-24s %s commands\n" "$sub" "$sub_cmd_count"
        done <<< "$subtopics"
        echo ""
    fi

    # Show commands
    local commands
    commands=$(discover_commands "$topic_path")
    if [[ -n "$commands" ]]; then
        echo "Available commands:"
        local _seen="|"
        while IFS='|' read -r command script_path source_dir; do
            _is_seen "$command" && continue; _seen="$_seen$command|"
            local description
            description=$(get_script_description "$script_path")
            printf "  %-24s %s\n" "$command" "$description"
        done <<< "$commands"
    fi
}

_print_command_list() {
    local dir_count="$1"
    local _seen="|"
    while IFS='|' read -r command script_path source_dir; do
        _is_seen "$command" && continue; _seen="$_seen$command|"

        local description
        description=$(get_script_description "$script_path")
        local dir_label=""
        if [[ "$dir_count" -gt 1 ]]; then
            dir_label=" ($(basename "$source_dir"))"
        fi
        printf "  %-24s %s%s\n" "$command" "$description" "$dir_label"
    done
}

_list_topic_recursive() {
    local topic_path="$1"
    local dir_count="$2"
    local display_path="${topic_path//\// > }"

    local commands
    commands=$(discover_commands "$topic_path")
    if [[ -n "$commands" ]]; then
        echo "[$display_path]"
        _print_command_list "$dir_count" <<< "$commands"
        echo ""
    fi

    # Recurse into subtopics if depth allows
    if can_descend_from_topic "$topic_path"; then
        local subtopics
        subtopics=$(discover_topic_names "$topic_path")
        if [[ -n "$subtopics" ]]; then
            while read -r sub; do
                _list_topic_recursive "$topic_path/$sub" "$dir_count"
            done <<< "$subtopics"
        fi
    fi
}

list_all_commands() {
    local dirs
    dirs=$(get_directories)
    if [[ -z "$dirs" ]]; then
        echo "No directories configured. Add one with:"
        echo "  rex dirs add <path>"
        return
    fi

    echo "All available commands:"
    echo ""

    local dir_count
    dir_count=$(get_directories | wc -l | tr -d ' ')

    discover_topic_names | while read -r topic; do
        _list_topic_recursive "$topic" "$dir_count"
    done

    # Standalone commands
    local standalone
    standalone=$(discover_standalone)
    if [[ -n "$standalone" ]]; then
        echo "[standalone]"
        _print_command_list "$dir_count" <<< "$standalone"
    fi
}

# ── Directory Management ─────────────────────────────────────────────────────

cmd_dirs() {
    local subcmd="${1:-}"

    case "$subcmd" in
        "add")
            local path="${2:-}"
            if [[ -z "$path" ]]; then
                echo "Usage: rex dirs add <path>"
                exit 1
            fi

            # Resolve to absolute path
            local abs_path
            abs_path=$(cd "$path" 2>/dev/null && pwd || true)
            if [[ -z "$abs_path" ]]; then
                echo "Error: directory does not exist: $path"
                exit 1
            fi

            # Check if already configured
            while IFS= read -r existing; do
                if [[ "$existing" == "$abs_path" ]]; then
                    echo "Already configured: $abs_path"
                    return
                fi
            done < <(get_directories)

            ensure_config
            echo "$abs_path" >> "$REX_CONFIG_FILE"
            echo "Added: $abs_path"
            ;;

        "remove")
            local path="${2:-}"
            if [[ -z "$path" ]]; then
                echo "Usage: rex dirs remove <path>"
                exit 1
            fi

            # Resolve to absolute path (may not exist anymore)
            local abs_path
            if [[ -d "$path" ]]; then
                abs_path=$(cd "$path" && pwd)
            else
                abs_path="$path"
            fi

            ensure_config
            local tmp
            tmp=$(mktemp)
            local found=false
            while IFS= read -r line; do
                local clean="${line%%#*}"
                clean="${clean#"${clean%%[![:space:]]*}"}"
                clean="${clean%"${clean##*[![:space:]]}"}"
                if [[ "$clean" == "$abs_path" ]]; then
                    found=true
                else
                    echo "$line" >> "$tmp"
                fi
            done < "$REX_CONFIG_FILE"

            if $found; then
                mv "$tmp" "$REX_CONFIG_FILE"
                echo "Removed: $abs_path"
            else
                rm "$tmp"
                echo "Not found in config: $abs_path"
                exit 1
            fi
            ;;

        "")
            # List configured directories
            local dirs
            dirs=$(get_directories)
            if [[ -z "$dirs" ]]; then
                echo "No directories configured."
                echo ""
                echo "Add one with: rex dirs add <path>"
            else
                echo "Configured directories:"
                while IFS= read -r dir; do
                    local topic_count cmd_count
                    topic_count=$(find "$dir" -maxdepth 1 -type d ! -name ".*" ! -path "$dir" 2>/dev/null | wc -l | tr -d ' ')
                    echo "  $dir ($topic_count topics)"
                done <<< "$dirs"
            fi
            ;;

        *)
            echo "Unknown dirs command: $subcmd"
            echo "Usage: rex dirs [add|remove] [path]"
            exit 1
            ;;
    esac
}

# ── Completions ───────────────────────────────────────────────────────────────

# Output completion words for the current cursor position
# Usage: rex --cmplt <cword_index> <words...>
_rex_completions() {
    local cword="$1"
    shift
    local words=("$@")

    if [[ "$cword" -eq 1 ]]; then
        # Position 1: built-ins + topics + standalone
        echo "help"
        echo "version"
        echo "list"
        echo "dirs"
        echo "new"
        echo "edit"
        echo "completions"
        discover_topic_names 2>/dev/null
        discover_standalone 2>/dev/null | cut -d'|' -f1
        return
    fi

    # Handle built-in subcommands at position 2
    if [[ "$cword" -eq 2 ]]; then
        case "${words[1]:-}" in
            dirs) echo "add"; echo "remove"; echo "list"; return ;;
            completions) echo "bash"; echo "zsh"; return ;;
        esac
    fi

    # Mirror dispatch: walk previously-typed words. If a word matches a
    # command, the cursor is past the script's invocation — no completions.
    # Otherwise, descend into matching subtopics.
    local topic_path=""
    local max_depth
    max_depth=$(get_max_depth)
    local depth=0
    local i
    for ((i = 1; i < cword; i++)); do
        local segment="${words[$i]}"
        local candidate_script
        if [[ -z "$topic_path" ]]; then
            candidate_script=$(resolve_standalone "$segment")
        else
            candidate_script=$(resolve_command "$topic_path" "$segment")
        fi
        if [[ -n "$candidate_script" ]]; then
            return
        fi
        [[ $depth -ge $max_depth ]] && break
        local candidate
        if [[ -n "$topic_path" ]]; then
            candidate="$topic_path/$segment"
        else
            candidate="$segment"
        fi
        if has_topic_dir "$candidate"; then
            topic_path="$candidate"
            depth=$((depth + 1))
        else
            break
        fi
    done

    if [[ -n "$topic_path" ]]; then
        echo "help"
        echo "list"
        if can_descend_from_topic "$topic_path"; then
            discover_topic_names "$topic_path" 2>/dev/null
        fi
        local _seen="|"
        while IFS='|' read -r cmd script_path source_dir; do
            _is_seen "$cmd" && continue; _seen="$_seen$cmd|"
            echo "$cmd"
        done < <(discover_commands "$topic_path" 2>/dev/null)
    fi
}

cmd_completions() {
    local shell="${1:-}"
    case "$shell" in
        bash)
            cat << 'BASH_COMPLETION'
_rex_bash_completions() {
    local cur="${COMP_WORDS[COMP_CWORD]}"
    local completions
    completions=$(rex --cmplt "$COMP_CWORD" "${COMP_WORDS[@]}" 2>/dev/null)
    COMPREPLY=($(compgen -W "$completions" -- "$cur"))
}
complete -F _rex_bash_completions rex
BASH_COMPLETION
            ;;
        zsh)
            cat << 'ZSH_COMPLETION'
_rex_zsh_completions() {
    local completions
    completions=("${(@f)$(rex --cmplt "$((CURRENT - 1))" "${words[@]}" 2>/dev/null)}")
    compadd -a completions
}
compdef _rex_zsh_completions rex
ZSH_COMPLETION
            ;;
        *)
            echo "Usage: rex completions [bash|zsh]"
            echo ""
            echo "Add to your shell profile:"
            echo "  bash: eval \"\$(rex completions bash)\""
            echo "  zsh:  eval \"\$(rex completions zsh)\""
            ;;
    esac
}

# ── New ───────────────────────────────────────────────────────────────────────

cmd_new() {
    local args=("$@")
    if [[ ${#args[@]} -eq 0 ]]; then
        echo "Usage: rex new <command>"
        echo "       rex new <topic> [subtopic...] <command>"
        exit 1
    fi

    ensure_config

    # Collect directories into an array
    local dirs=()
    while IFS= read -r d; do
        dirs+=("$d")
    done < <(get_directories)

    if [[ ${#dirs[@]} -eq 0 ]]; then
        echo "No directories configured. Add one with:"
        echo "  rex dirs add <path>"
        exit 1
    fi

    # Pick target directory
    local target_dir
    if [[ ${#dirs[@]} -eq 1 ]]; then
        target_dir="${dirs[0]}"
    else
        echo "Select a directory:"
        local i
        for i in "${!dirs[@]}"; do
            echo "  $((i + 1))) ${dirs[$i]}"
        done
        local choice
        read -p "Directory [1-${#dirs[@]}]: " choice
        if ! [[ "$choice" =~ ^[0-9]+$ ]] || [[ "$choice" -lt 1 ]] || [[ "$choice" -gt ${#dirs[@]} ]]; then
            echo "Invalid selection"
            exit 1
        fi
        target_dir="${dirs[$((choice - 1))]}"
    fi

    # Determine file path
    local file_path
    if [[ ${#args[@]} -gt 1 ]]; then
        # Topic command: all args except last form the topic path
        local topic_path=""
        for ((i = 0; i < ${#args[@]} - 1; i++)); do
            if [[ -n "$topic_path" ]]; then
                topic_path="$topic_path/${args[$i]}"
            else
                topic_path="${args[$i]}"
            fi
        done
        local command="${args[${#args[@]}-1]}"
        local leaf
        leaf=$(basename "$topic_path")
        mkdir -p "$target_dir/$topic_path"
        file_path="$target_dir/$topic_path/${leaf}-${command}.sh"
    else
        # Standalone: rex new <command>
        file_path="$target_dir/${args[0]}.sh"
    fi

    # Check for conflicts
    if [[ -e "$file_path" ]]; then
        echo "Error: already exists: $file_path"
        exit 1
    fi

    # Scaffold the script
    cat > "$file_path" << 'TEMPLATE'
#!/bin/bash
# Description:

TEMPLATE
    chmod +x "$file_path"
    echo "Created: $file_path"

    # Open in editor
    "${EDITOR:-vi}" "$file_path"
}

# ── Edit ──────────────────────────────────────────────────────────────────────

cmd_edit() {
    if [[ -z "${1:-}" ]]; then
        echo "Usage: rex edit <command>"
        echo "       rex edit <topic> [subtopic...] <command>"
        exit 1
    fi

    # `rex edit` syntax fixes the command at the last position, so descend
    # only over the preceding args. This avoids the dispatch-time ambiguity
    # where a subtopic name shadows a sibling command.
    local args=("$@")
    local last_idx=$((${#args[@]} - 1))
    local topic_path=""
    local depth=0
    local max_depth
    max_depth=$(get_max_depth)

    local i
    for ((i = 0; i < last_idx; i++)); do
        [[ $depth -ge $max_depth ]] && break
        local segment="${args[$i]}"
        local candidate
        if [[ -n "$topic_path" ]]; then
            candidate="$topic_path/$segment"
        else
            candidate="$segment"
        fi
        if has_topic_dir "$candidate"; then
            topic_path="$candidate"
            depth=$((depth + 1))
        else
            break
        fi
    done

    local command="${args[$last_idx]}"
    local script
    if [[ -n "$topic_path" ]]; then
        script=$(resolve_command "$topic_path" "$command")
    else
        script=$(resolve_standalone "$command")
    fi

    if [[ -z "$script" ]]; then
        # If the trailing arg is itself a topic, the user probably forgot the
        # command — show the usage hint instead of an "unknown command" error.
        local check_path
        if [[ -n "$topic_path" ]]; then
            check_path="$topic_path/$command"
        else
            check_path="$command"
        fi
        if has_topic_dir "$check_path"; then
            echo "Usage: rex edit <topic> [subtopic...] <command>"
            exit 1
        fi
        if [[ -n "$topic_path" ]]; then
            echo "Unknown ${topic_path##*/} command: $command"
        else
            echo "Unknown command: $command"
        fi
        exit 1
    fi

    "${EDITOR:-vi}" "$script"
}

# ── Execution ─────────────────────────────────────────────────────────────────

run_script() {
    local invocation="$1"
    local script="$2"
    shift 2

    # Export full invocation for child scripts
    for arg in "$@"; do
        invocation+=" $(printf %q "$arg")"
    done
    export REX_CMD="$invocation"

    exec "$script" "$@"
}

# ── Main ──────────────────────────────────────────────────────────────────────

main() {
    # Validate max_depth config before dispatching any command.
    get_max_depth >/dev/null

    case "${1:-}" in
        "help"|"--help"|"-h"|"")
            show_help
            ;;
        "version"|"--version"|"-v")
            echo "rex v${REX_VERSION}"
            ;;
        "list")
            list_all_commands
            ;;
        "new")
            shift
            cmd_new "$@"
            ;;
        "edit")
            shift
            cmd_edit "$@"
            ;;
        "completions")
            shift
            cmd_completions "$@"
            ;;
        "--cmplt")
            shift
            _rex_completions "$@"
            ;;
        "dirs")
            shift
            cmd_dirs "$@"
            ;;
        *)
            # Walk args left-to-right. At each segment: prefer command match
            # (standalone at root, topic command otherwise) over descending into
            # a subtopic. This makes a command unambiguously reachable even when
            # a subdirectory shares its name.
            local args=("$@")
            local topic_path=""
            local depth=0
            local max_depth
            max_depth=$(get_max_depth)
            local script_path=""
            local cmd_idx=-1
            local i

            for ((i = 0; i < ${#args[@]}; i++)); do
                local segment="${args[$i]}"
                local candidate_script
                if [[ -z "$topic_path" ]]; then
                    candidate_script=$(resolve_standalone "$segment")
                else
                    candidate_script=$(resolve_command "$topic_path" "$segment")
                fi
                if [[ -n "$candidate_script" ]]; then
                    script_path="$candidate_script"
                    cmd_idx=$i
                    break
                fi
                if [[ $depth -lt $max_depth ]]; then
                    local candidate
                    if [[ -n "$topic_path" ]]; then
                        candidate="$topic_path/$segment"
                    else
                        candidate="$segment"
                    fi
                    if has_topic_dir "$candidate"; then
                        topic_path="$candidate"
                        depth=$((depth + 1))
                        continue
                    fi
                fi
                break
            done

            if [[ -n "$script_path" ]]; then
                local invocation="rex"
                local j
                for ((j = 0; j <= cmd_idx; j++)); do
                    invocation+=" ${args[$j]}"
                done
                run_script "$invocation" "$script_path" "${args[@]:$((cmd_idx + 1))}"
            elif [[ -n "$topic_path" ]]; then
                local rest_arg="${args[$depth]:-}"
                if [[ -z "$rest_arg" || "$rest_arg" == "help" || "$rest_arg" == "--help" || "$rest_arg" == "-h" || "$rest_arg" == "list" ]]; then
                    show_topic_help "$topic_path"
                else
                    echo "Unknown ${topic_path##*/} command: $rest_arg"
                    echo ""
                    show_topic_help "$topic_path"
                    exit 1
                fi
            else
                echo "Unknown topic or command: $1"
                echo ""
                show_help
                exit 1
            fi
            ;;
    esac
}

main "$@"
